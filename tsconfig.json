{
	"compilerOptions": {
		"target": "ESNext",
		"lib": ["dom", "dom.iterable", "esnext"],
		"allowJs": true,
		"skipLibCheck": true,
		"strict": true,
		"noEmit": true,
		"esModuleInterop": true,
		"module": "esnext",
		"moduleResolution": "bundler",
		"resolveJsonModule": true,
		"isolatedModules": true,
		"jsx": "react-jsx",
		"incremental": true,
		"plugins": [
			{
				"name": "next"
			}
		],
		"baseUrl": ".",
		"paths": {
			"@/*": ["./src/*"],
			"@prisma/client": ["src/generated/prisma"],
			"@prisma/client/*": ["src/generated/prisma/*"]
		}
	},
	"include": [
		"next-env.d.ts",
		"**/*.ts",
		"**/*.tsx",
		".next/types/**/*.ts",
		".next\\dev/types/**/*.ts",
		".next\\dev/types/**/*.ts",
		".next/dev/types/**/*.ts",
		"dist\\dev/types/**/*.ts",
		"dist\\dev/types/**/*.ts",
		"src/hooks/useInputts"
	],
	"exclude": ["node_modules", "out", ".next", "src-tauri/target"]
}
